-- Tactical Compass -- stateless helpers.
-- Author: explorerbee

local V = tc_variables

local CENTER = V.TC_SCREEN_CENTER
local LERP = V.TC_MARKER_LERP
local LERP_FAST = V.TC_MARKER_LERP_FAST
local JUMP = V.TC_MARKER_JUMP
local FADE = V.TC_FADE_DISTANCE

-- Scaled to the active compass style by set_scale; see TC_COMPASS_BASE_WIDTH
local spread = V.TC_MARKER_SPREAD
local clamp_px = V.TC_MARKER_CLAMP
local look = V.TC_LOOK_TOLERANCE

local abs, floor = math.abs, math.floor

-- Scratch vectors, reused so calc_position allocates nothing per marker.
local scratch_dir = vector()
local scratch_cross = vector()

function lerp(a, b, t)
  return a + (b - a) * t
end

-- Called by tc_hud when the window is built: markers must spread across the
-- whole strip, and the legacy strip is wider than the one the constants assume.
function set_scale(k)
  spread = V.TC_MARKER_SPREAD * k
  clamp_px = V.TC_MARKER_CLAMP * k
  look = V.TC_LOOK_TOLERANCE * k
end

function calc_angle()
  local dir = device().cam_dir
  local angle = math.deg(math.atan2(dir.x, dir.z))

  if angle < 0 then angle = angle + 360 end

  return angle
end

function get_world_coordinates(id)
  local obj = db.storage[id] and db.storage[id].object or level.object_by_id(id)

  if obj then
    if IsStalker(obj) or IsMonster(obj) then
      return utils_obj.safe_bone_pos(obj, "bip01_head")
    end

    if type(obj.position) == "function" then
      local pos = obj:position()

      return pos and vector():set(pos.x, pos.y + 1, pos.z)
    end
  end

  local se = alife_object(id)
  if not (se and se.online) then return nil end

  local cls = se:clsid()

  if cls == clsid.smart_terrain then
    local pos = se.position

    return pos and vector():set(pos.x, pos.y + 1, pos.z)
  end

  if cls == clsid.online_offline_group_s then
    local leader = se:commander_id()
    local npc = leader and (db.storage[leader] and db.storage[leader].object or level.object_by_id(leader))

    return npc and utils_obj.safe_bone_pos(npc, "bip01_head")
  end

  return nil
end

function calc_distance_to_target(world_pos, actor_pos)
  if world_pos and actor_pos then
    return floor(world_pos:distance_to(actor_pos))
  end

  return nil
end

function calc_alpha(always_visible, distance, threshold)
  if always_visible or distance <= threshold then return 255 end
  if distance >= threshold + FADE then return 0 end

  return floor(255 - ((distance - threshold) / FADE) * 255)
end

-- Horizontal screen position of a world point on the compass strip.
-- actor_dir must already be flattened and normalised.
function calc_position(world_pos, actor_pos, actor_dir, prev_x)
  scratch_dir:set(world_pos.x, actor_pos.y, world_pos.z)
  scratch_dir:sub(actor_pos)

  if scratch_dir:magnitude() < 0.001 then
    return prev_x or CENTER
  end

  scratch_dir:normalize()

  local dot = scratch_dir:dotproduct(actor_dir)
  scratch_cross:crossproduct(scratch_dir, actor_dir)

  local side = (scratch_cross.y < 0) and 1 or -1
    local x = CENTER + side * (1 - dot) * spread

  local factor = LERP
  if prev_x and abs(x - prev_x) > JUMP then
    factor = LERP_FAST
  end

  x = lerp(prev_x or CENTER, x, factor)

  -- A target directly behind gives dot = -1, so the offset lands on 2 * SPREAD
  if x < CENTER - clamp_px then return CENTER - clamp_px end
  if x > CENTER + clamp_px then return CENTER + clamp_px end

  return x
end

function is_looking_at(x)
  return x and abs(x - CENTER) <= look
end