-- Tactical Compass - engine callback hooks
-- Author: explorerbee

axr_main.callback_add("actor_map_location_added")

local function on_map_location_added(binder, spot_item, id)
  SendScriptCallback("actor_map_location_added", binder, spot_item, id)

  -- One handler per callback: Wearable Devices takes the slot on first update,
  -- so we take it back and forward spots to its registry
  if wd_map_spots and wd_map_spots.get_registry then
    wd_map_spots.get_registry().add(spot_item, id)
  end
end

local function retake_slot(binder)
  UnregisterScriptCallback("actor_on_update", retake_slot)

  if binder and binder.object then
    binder.object:set_callback(callback.map_location_added, on_map_location_added, binder)
  end
end

-- Runs right after all first-update handlers, in the same frame
local function arm_retake()
  RegisterScriptCallback("actor_on_update", retake_slot)
end

function on_game_start()
  local binder = bind_stalker and bind_stalker.actor_binder

  if not (binder and callback and callback.map_location_added) then
    printf("![tc_binder] cannot hook map_location_added, markers will only "
      .. "appear after a level load")
    return
  end

  local base_reinit = binder.reinit

  function binder:reinit()
    base_reinit(self)

    self.object:set_callback(callback.map_location_added, on_map_location_added, self)
  end

  local base_net_destroy = binder.net_destroy

  function binder:net_destroy()
    self.object:set_callback(callback.map_location_added, nil)

    base_net_destroy(self)
  end

  RegisterScriptCallback("actor_on_first_update", arm_retake)
end
