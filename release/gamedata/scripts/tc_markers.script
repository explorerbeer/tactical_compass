-- Tactical Compass - marker registry
-- Author: explorerbee

local defs = tc_defs

list = {} -- [object id] = { [spot type] = entry }

local function make_entry(id, spot, category)
  local group = defs.category_groups[category]
  if not group then return nil end

  return {
    id = id,
    spot = spot,
    category = category,
    group = group,

    wpos = vector(),
    distance = -1,
    distance_str = "",
    alpha = 0,
    show_distance = false,
    y = 0,

    -- written by tc_hud
    ui = nil,
    arrow_x = 0,
    shadow = nil,
    half_width = 0,
    edge = 0,
    x = nil,
    shown = false,
    applied_alpha = -1,
    applied_arrow = 0,
    applied_text = "",
  }
end

function add(id, spot, category)
  if not (id and spot) then return end

  category = category or defs.spot_categories[spot] or defs.transition_types[spot]
  if not category then return end

  local spots = list[id]
  if not spots then
      spots = {}
      list[id] = spots
  end

  if spots[spot] then return end

  local entry = make_entry(id, spot, category)
  if entry then spots[spot] = entry end
end

function remove(id, spot)
  local spots = list[id]
  if not spots then return end

  local entry = spots[spot]
  if entry then
    if tc_hud.HUD then tc_hud.HUD:ReleaseMarker(entry) end
    spots[spot] = nil
  end

  if next(spots) == nil then list[id] = nil end
end

function clear(id)
  local spots = list[id]
  if not spots then return end

  if tc_hud.HUD then
    for _, entry in pairs(spots) do
      tc_hud.HUD:ReleaseMarker(entry)
    end
  end

  list[id] = nil
end

-- Load-time scan for spots added before install or while another addon
-- held the callback. SCAN_CHUNK ids per frame.

local MAX_ID = 65534
local SCAN_CHUNK = tc_variables.TC_SCAN_CHUNK

local scan_index = nil

-- For exes without map_get_object_spots_by_id
local known_spots = {}
for spot in pairs(defs.spot_categories) do known_spots[#known_spots + 1] = spot end
for spot in pairs(defs.transition_types) do known_spots[#known_spots + 1] = spot end

local function scan_by_id(first, last)
  local get_spots = level.map_get_object_spots_by_id

  for id = first, last do
    local spots = get_spots(id)

    if spots then
      for i = 1, #spots do
        on_map_location_added(nil, spots[i].spot_type, id)
      end
    end
  end
end

local function scan_by_probe(first, last)
  local sim = alife()
  if not sim then return end

  local has_spot = level.map_has_object_spot

  for id = first, last do
    if sim:object(id) then
      for i = 1, #known_spots do
        local spot = known_spots[i]
        if has_spot(id, spot) ~= 0 then add(id, spot) end
      end
    end
  end
end

local function scan_step()
  local first = scan_index
  local last = math.min(first + SCAN_CHUNK - 1, MAX_ID)

  if level.map_get_object_spots_by_id then
    scan_by_id(first, last)
  else
    scan_by_probe(first, last)
  end

  if last >= MAX_ID then
    scan_index = nil
    UnregisterScriptCallback("actor_on_update", scan_step)
  else
    scan_index = last + 1
  end
end

function start_scan()
  if not scan_index then RegisterScriptCallback("actor_on_update", scan_step) end
  scan_index = 1
end

function stop_scan()
  if scan_index then UnregisterScriptCallback("actor_on_update", scan_step) end
  scan_index = nil
end

function drop_stale_spots()
  for id, spots in pairs(list) do
    for spot in pairs(spots) do
      if level.map_has_object_spot(id, spot) == 0 then
        remove(id, spot)
      end
    end
  end
end

function on_map_location_added(binder, spot, id)
    if defs.blacklisted_spots[spot] then return end

    add(id, spot)
end

-- Only plain data can be saved
function save_state(m_data)
  local saved = {}

  for id, spots in pairs(list) do
    local out

    for spot, entry in pairs(spots) do
      out = out or {}
      out[spot] = entry.category
    end

    if out then saved[id] = out end
  end

  m_data.tc_markers = saved
  m_data.init_markers = nil -- key of older versions
end

function load_state(m_data)
  list = {}

  local saved = m_data.tc_markers or m_data.init_markers
  if not saved then return end

  for id, spots in pairs(saved) do
    for spot, data in pairs(spots) do
      add(id, spot, type(data) == "table" and data.category or data)
    end
  end
end

function on_game_start()
  RegisterScriptCallback("actor_on_first_update", start_scan)
  RegisterScriptCallback("actor_on_net_destroy", stop_scan)
  RegisterScriptCallback("actor_map_location_added", on_map_location_added)

  RegisterScriptCallback("save_state", save_state)
  RegisterScriptCallback("load_state", load_state)
end