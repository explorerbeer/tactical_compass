-- Tactical Compass - lookup tables
-- Author: explorerbee

-- PDA spot type -> marker category. Each category needs a <marker_CATEGORY>
-- node in ui_markers.xml and a group below, otherwise the spot is ignored.

spot_categories = {
  -- Quests
  storyline_task_location = "primary",
  secondary_task_location = "secondary",

  -- Unique NPCs
  ui_pda2_trader_location = "trader",
  ui_pda2_special_location = "special",
  ui_pda2_mechanic_location = "mechanic",
  ui_pda2_scout_location = "scout",
  ui_pda2_barman_location = "barman",
  ui_pda2_quest_npc_location = "quest_npc",
  ui_pda2_medic_location = "medic",
  ui_pda2_companion_location = "companion",

  -- Sleep zones
  ui_pda2_actor_sleep_location = "sleep",

  -- Stashes
  treasure_all = "stashes_all",
  treasure_unique = "stashes_unique",
  treasure_searched = "stashes_searched",
  treasure_player = "stashes_player",
  treasure = "stashes",

  -- Squads
  warfare_stalker_spot = "stalker",
  warfare_bandit_spot = "bandit",
  warfare_csky_spot = "csky",
  warfare_army_spot = "army",
  warfare_freedom_spot = "freedom",
  warfare_duty_spot = "dolg",
  warfare_ecolog_spot = "ecolog",
  warfare_killer_spot = "killer",
  warfare_monolith_spot = "monolith",
  warfare_greh_spot = "greh",
  warfare_renegade_spot = "renegade",
  warfare_isg_spot = "isg",
  red_location = "unknown",

  -- Water pumps (Fillable Canteens compatibility)
  water_spot = "water",

  -- Campfires (Campfires on Minimap compatibility)
  campfire_lit = "campfire_lit",
  campfire_unlit = "campfire_unlit",

  -- Corpses (Milspec PDA compatibility)
  deadbody_location = "deadbody",
  deadbody_location_sdot = "deadbody",
  deadbody_location_mdot = "deadbody",
  deadbody_location_ldot = "deadbody",
  deadbody_location_skul = "deadbody",
  deadbody_location_whtx = "deadbody",
}

