-- Level changers. Added before the callback is hooked, so only the load-time
-- scan in tc_markers finds them
transition_types = {
  level_changer_up = "transition",
  level_changer_up_right = "transition",
  level_changer_right = "transition",
  level_changer_right_down = "transition",
  level_changer_down = "transition",
  level_changer_down_left = "transition",
  level_changer_left = "transition",
  level_changer_left_up = "transition",
}

-- Spot types we never track
blacklisted_spots = {
  fast_travel = true,
  actor_location = true,
  actor_location_p = true,
  primary_object = true,
  ui_primary_task_blink = true,
  ui_secondary_task_blink = true,
  mp_hit_sector_location = true,
  warfare_zombied_spot = true,
  warfare_mutant_spot = true,
  anom_zone = true,
  artefact = true,
  paw_ping = true,          -- PAW pings
  paw_ping_alpha50 = true,
  paw_task_default = true,  -- duplicates the PAW waypoint task spot
}

-- Categories without an up/down arrow
no_arrow = {
  deadbody = true,
}

-- MCM group -> categories. The group name is the suffix of its MCM keys
-- (show_<g>, is_<g>_dist, is_<g>_av, show_<g>_dist) and must exist in tc_mcm.
local groups = {
  quest = { "primary", "secondary" },
  unique = { "special", "trader", "mechanic", "scout", "barman", "quest_npc", "medic", "companion" },
  sleep = { "sleep" },
  stashes = { "stashes", "stashes_all", "stashes_unique", "stashes_searched", "stashes_player" },
  transitions = { "transition" },
  squads = { "stalker", "bandit", "csky", "army", "freedom", "dolg", "ecolog", "killer", "monolith", "greh", "renegade", "isg", "unknown" },
  corpses = { "deadbody" },
  campf = { "campfire_lit", "campfire_unlit" },
  pump = { "water" },
  paw = paw_spots,
}

category_groups = {}

for group, categories in pairs(groups) do
  for i = 1, #categories do
    category_groups[categories[i]] = group
  end
end