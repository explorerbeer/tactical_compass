-- Tactical Compass - layout constants and tuning
-- Author: explorerbee


TC_SCREEN_CENTER = 512
TC_SCREEN_WIDTH = 1024
TC_SCREEN_HEIGHT = 768

TC_MAX_POSSIBLE_DISTANCE = 1000

-- Compass styles, keyed by tc_main/compass_style
TC_STYLES = {
  [0] = {
    node = "compass_s2",
    has_background = false,
    has_degrees = false,

    compass_width = 360,
    compass_inset = 0,

    pos_key = "tc_main/compass_y_s2",
    default_y = 721,
    pos_min = 11,                     -- distance text above the markers
    pos_max = TC_SCREEN_HEIGHT - 37,  -- bottom of the frame

    marker_offset = 8,
    deadbody_offset = 30,
  },

  [1] = {
    node = "compass_legacy",
    has_background = true,
    has_degrees = true,

    compass_width = 600,
    compass_inset = 5, -- cardinal_dir x in the container

    pos_key = "tc_main/compass_y_legacy",
    default_y = 671,
    pos_min = 0,                      -- markers sit inside the background
    pos_max = TC_SCREEN_HEIGHT - 85,  -- bottom of the background

    marker_offset = 25,
    deadbody_offset = 25,
  },
}

-- Marker icon sets, keyed by tc_markers/marker_style
TC_MARKER_SETS = {
    -- gamma_stashes: G.A.M.M.A. PDA stash colours (tc_markers/gamma_stashes)
    [0] = { node = "markers_custom",  highlight_pad = 2,
            gamma_stashes = {
                stashes = "tc_stash_white",
                stashes_all = "tc_stash_white",
                stashes_searched = "tc_stash_player",
                stashes_player = "tc_stash_blue",
            } },
    -- Textures from AlphaLion's Reworked Stash Quest and Map Markers
    [1] = { node = "markers_vanilla", highlight_pad = 6,
            gamma_stashes = {
                stashes = "ui_AlphaLion_Stash-regular",
                stashes_all = "ui_AlphaLion_Stash-regular",
                stashes_searched = "ui_AlphaLion_Stash-valuable",
                stashes_player = "ui_AlphaLion_Stash-self",
                stashes_unique = "ui_AlphaLion_Stash-UNISG",
            } },
}

-- Shared by both styles
TC_CARDINAL_TEXTURE_WIDTH = 4096
TC_VISIBLE_DEGREES = 240

TC_PX_PER_DEGREE = TC_CARDINAL_TEXTURE_WIDTH / (360 + TC_VISIBLE_DEGREES)
TC_CARDINAL_WIDTH = TC_VISIBLE_DEGREES * TC_PX_PER_DEGREE
TC_CARDINAL_HEIGHT = 100

TC_FADE_DISTANCE = 10

-- Marker movement
TC_COMPASS_BASE_WIDTH = 360

TC_MARKER_SPREAD = 220      -- px per unit of (1 - dot product)
TC_MARKER_CLAMP = 300       -- max offset from screen centre
TC_MARKER_LERP = 0.1        -- smoothing, normal
TC_MARKER_LERP_FAST = 0.5   -- smoothing, after a large jump
TC_MARKER_JUMP = 100        -- px, what counts as a large jump
TC_LOOK_TOLERANCE = 10      -- px, how close to centre counts as "looking at"

-- Update rates, ms
TC_TICK_VISIBILITY = 250    -- HUD show/hide check
TC_TICK_MARKERS = 200       -- marker world state (position, distance, alpha)
TC_TICK_CLEANUP = 2000      -- stale map spot check

-- Shadow under the compass strip
TC_COMPASS_SHADOW_ALPHA = 140
TC_COMPASS_SHADOW_OFFSET = 0.5

-- Shadow under markers, toggled by tc_markers/marker_shadow
TC_MARKER_SHADOW_ALPHA = 140
TC_MARKER_SHADOW_OFFSET = 0.5

-- Markers created per slow tick
TC_CREATE_BUDGET = 6

-- Object ids per frame for the load-time spot scan
TC_SCAN_CHUNK = 8000